# Връзка с базата на Microinvest Склад Про (SQL Server).
# Копирайте този файл като .env до server.js и попълнете стойностите.
# .env не се качва в git.

# Сървър: localhost, или localhost\SQLEXPRESS за именувана инстанция
MI_SQL_SERVER=localhost
# Порт — само ако не е стандартният 1433 и SQL Server Browser не работи
# MI_SQL_PORT=1433
MI_SQL_DATABASE=
# Потребител само за четене (вижте README)
MI_SQL_USER=payroll_report
MI_SQL_PASSWORD=
# 1 = криптирана връзка. Не е нужна, когато програмата е на същия компютър като SQL Server.
MI_SQL_ENCRYPT=0

# Порт на програмата (по подразбиране 3000)
PORT=3001
# 127.0.0.1 = достъп само от този компютър; отвън се влиза през tailscale serve.
# Без HOST програмата слуша на всички мрежови адреси.
HOST=127.0.0.1

# Час за ежедневното резервно копие на данните (по подразбиране 21:05)
# BACKUP_TIME=21:05

# Втора папка за резервните копия: друг диск или NAS (по желание)
# BACKUP_COPY_DIR=\\NAS\backup\payroll
# Потребител и парола на NAS. Нужни са, защото услугата работи като SYSTEM и не вижда паролите,
# запазени в Explorer. Ако в паролата има # или интервал, сложете я в кавички.
# BACKUP_COPY_USER=потребител
# BACKUP_COPY_PASSWORD=парола
